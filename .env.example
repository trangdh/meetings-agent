ANTHROPIC_API_KEY=
# Rẻ hơn Opus ~60%, đủ tốt cho correct + summarize. Dùng claude-opus-4-8 nếu ưu tiên chất lượng tối đa.
CLAUDE_MODEL=claude-sonnet-5

# Chỉ cần trên macOS/Linux — Windows tự dùng WASAPI loopback trên loa mặc định,
# không cần set. macOS/Linux không có API loopback nên phải cài virtual audio
# device (vd BlackHole) rồi điền tên thiết bị đó vào đây. Xem README mục
# "Setup audio trên macOS".
# LOOPBACK_DEVICE=BlackHole 2ch

# "local" = faster-whisper chạy trên máy (free, nhưng chậm ~1.4-1.8x thời gian thực vì không có GPU).
# "groq" = gọi Groq API (cloud, ~50-100x thời gian thực, cần GROQ_API_KEY). Recording sẽ được upload lên Groq.
TRANSCRIBE_BACKEND=local

# Chỉ dùng khi TRANSCRIBE_BACKEND=local. "medium" chính xác hơn "small" nhưng chậm hơn ~2-3x trên CPU.
WHISPER_MODEL=medium

# Chỉ dùng khi TRANSCRIBE_BACKEND=groq. Lấy key tại console.groq.com.
# GROQ_API_KEY=
# GROQ_MODEL=whisper-large-v3

# Loại họp cho bước summarize:
#   auto    = tự nhận diện từ transcript (sprint/client/general) — an toàn nếu quên đổi profile
#   sprint  = họp sprint (review + planning dev/QA)
#   client  = họp với khách hàng/partner
#   general = buổi họp nội bộ khác
# Override từng lần: meetings-agent summarize --type client (hoặc chọn dropdown trong GUI).
MEETING_TYPE=auto

# true = sau khi summarize xong, tự động commit + push file summary lên GitHub
# (chỉ stage đúng file summary, không đụng file khác). false = không tự push.
AUTO_PUSH=false

# Chỉ cần cho `meetings-agent watch` (tự thu khi bạn vào huddle Slack). Phải là
# USER token (xoxp-), không phải bot token: API trả về trạng thái của chính chủ
# token, mà bot thì không bao giờ ở trong huddle. Scope cần: `users.profile:read`.
# Các lệnh khác không dùng token này. Xem README mục "Tự động thu khi vào huddle".
# SLACK_TOKEN=xoxp-...

# WHISPER_LANGUAGE=vi
# KNOWLEDGE_FILE=C:\path\to\your\knowledge.md
